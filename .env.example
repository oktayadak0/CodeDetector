# CodeDetector ortam ayarları. Bu dosyayı .env olarak kopyalayın.
# Model adresi varsayılan olarak yereldir.
OLLAMA_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma4:e2b

# Bağlantı ve üretim ayarları
GEMMA_TIMEOUT=300
GEMMA_CONNECT_TIMEOUT=5
GEMMA_NUM_CTX=16384
GEMMA_NUM_PREDICT=4096
GEMMA_TEMPERATURE=0.1
# false, true veya auto
GEMMA_THINK=false
GEMMA_MAX_RETRIES=1
ANALYSIS_LANGUAGE=tr

# Girdi sınırları
MAX_MODEL_INPUT_CHARS=24000
MAX_CODE_CHARS=200000
MAX_UPLOAD_BYTES=524288
MAX_REQUEST_BYTES=2097152

# auto: model kapalıyken örnek demo; on: her zaman; off: kapalı
DEMO_MODE=auto
APP_HOST=127.0.0.1
APP_PORT=5000
